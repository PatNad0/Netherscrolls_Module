<section class="netherscrolls-sidebar-panel">
  <header class="netherscrolls-sidebar-panel__header">
    <h2>Netherscrolls</h2>
  </header>

  <div class="netherscrolls-sidebar-panel__actions">
    <button type="button" data-action="openModuleConfig">
      <i class="fa-solid fa-sliders" aria-hidden="true"></i>
      Module configuration
    </button>
    <button type="button" data-action="openImporter">
      <i class="fa-solid fa-cloud-arrow-down" aria-hidden="true"></i>
      Open importer
    </button>
  </div>

  {{#if visionLimitEnabled}}
  <section class="netherscrolls-sidebar-panel__feature">
    <button type="button" data-action="openHardVision">
      <i class="fa-solid fa-eye-low-vision" aria-hidden="true"></i>
      Limit player vision
    </button>
    <p class="hint">Select a token you own, then choose a maximum vision range.</p>
  </section>
  {{else}}
  <p class="hint netherscrolls-sidebar-panel__disabled">Player vision limit is disabled in Netherscrolls module settings.</p>
  {{/if}}
</section>